# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brighttrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/brighttrack

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  (min 32 chars in production)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=7

# Frontend origin(s) allowed by CORS, comma separated, no trailing slash
CLIENT_ORIGIN=http://localhost:5173

# Cookies. Defaults: dev = lax/insecure, production = none/secure (needed when Vercel and Render are on different domains)
COOKIE_NAME=bt_token
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

LOG_LEVEL=info
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Seed script (npm run seed). In production the password MUST be set explicitly.
SEED_ADMIN_NAME=BrightTrack Admin
SEED_ADMIN_EMAIL=admin@brighttrack.local
SEED_ADMIN_PASSWORD=ChangeMe123!
