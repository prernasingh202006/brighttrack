# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brighttrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/brighttrack

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  (min 32 chars in production)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=7

# Frontend origin(s) allowed by CORS, comma separated, no trailing slash
CLIENT_ORIGIN=http://localhost:5173

# Cookies. Defaults: dev = lax/insecure, production = none/secure (needed when Vercel and Render are on different domains)
COOKIE_NAME=bt_token
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

LOG_LEVEL=info

# Sign-up rejects email domains that cannot receive mail (DNS lookup). Fails open if DNS is down.
# EMAIL_DNS_CHECK=true

# ---- Email verification (sign-up sends a 6-digit code) ----
# LOCAL TESTING: the code is printed in this server's terminal instead of being emailed.
MAIL_PROVIDER=console
# REAL EMAILS (required in production): create a free Brevo account (300 emails/day), verify a sender
# address there, create an API key, then set both values below. They override MAIL_PROVIDER.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=you@yourdomain.com
# MAIL_FROM_NAME=BrightTrack

# ---- Address search for the "Location" field (OpenStreetMap Nominatim, free) ----
# Their policy asks you to identify your app: put a contact email or your site URL here.
GEO_CONTACT=you@example.com
# Countries the search is limited to (comma separated ISO codes; empty = anywhere)
GEO_COUNTRY_CODES=in
# Number of reverse proxies in front of the API: 1 = Render only, 2 = Vercel forwarding /api to Render
# TRUST_PROXY_HOPS=1
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Seed script (npm run seed). In production the password MUST be set explicitly.
SEED_ADMIN_NAME=BrightTrack Admin
SEED_ADMIN_EMAIL=admin@brighttrack.local
SEED_ADMIN_PASSWORD=ChangeMe123!
